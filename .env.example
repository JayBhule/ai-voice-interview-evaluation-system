# ── Ollama Configuration ──────────────────────────────────────────────────────
# URL of your locally running Ollama service
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for interview generation and evaluation.
# Must be pulled first: ollama pull gemma2:2b
# Other options: qwen2.5:3b, llama3.2:3b, mistral:7b
OLLAMA_MODEL=gemma2:2b

# ── Whisper STT Configuration ─────────────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v2, large-v3
# 'base' is a good balance for a typical laptop (≈145 MB).
# Set to 'tiny' if you're on a very low-resource machine.
WHISPER_MODEL_SIZE=base

# ── Application Settings ──────────────────────────────────────────────────────
# Maximum number of interview questions allowed
MAX_QUESTIONS=10

# Default number of questions
DEFAULT_QUESTIONS=5

# Enable text-to-speech by default (true/false)
TTS_ENABLED=true
